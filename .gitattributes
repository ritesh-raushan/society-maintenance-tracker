# Normalize all line endings to LF in the repository and on checkout
* text=auto eol=lf

# Windows scripts that genuinely require CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries (never modified)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
